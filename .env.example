# Copie para .env e ajuste os valores. NUNCA versione o arquivo .env.

# --- Banco: Supabase (padrão atual) ---
# Senha em: Supabase > Project Settings > Database
DB_USERNAME=postgres
DB_PASSWORD=
# Opcional: sobrescreve a URL (ex.: Session Pooler IPv4 do Supabase)
# DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.upumrylyyiilgxnpgdlr
# DB_SCHEMA=nummia

# Para usar o PostgreSQL local do docker-compose em vez do Supabase:
# SPRING_PROFILES_ACTIVE=dev   (rodando com ./mvnw)

# Gere com: openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Serviço de IA (n8n / LangGraph / Python). Vazio = assistente local por regras.
# Com o n8n do docker-compose: http://n8n:5678/webhook/nummia-assistant
AI_WEBHOOK_URL=
AI_API_KEY=

# Webhook que recebe eventos da plataforma (notificações) para automações.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
