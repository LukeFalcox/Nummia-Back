# Copie para .env e ajuste os valores. NUNCA versione o arquivo .env.

DB_USERNAME=nummia
DB_PASSWORD=troque-esta-senha

# Gere com: openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true

# Serviço de IA (n8n / LangGraph / Python). Vazio = assistente local por regras.
# Com o n8n do docker-compose: http://n8n:5678/webhook/nummia-assistant
AI_WEBHOOK_URL=
AI_API_KEY=

# Webhook que recebe eventos da plataforma (notificações) para automações.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
